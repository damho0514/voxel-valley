{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voxel-valley-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "observability": { "enabled": true },
  // New room connections per IP per minute: stops guessing room codes by brute force.
  "ratelimits": [{ "name": "CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }]
}
