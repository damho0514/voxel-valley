{
  "expo": {
    "name": "Voxel Valley",
    "slug": "voxel-valley-go",
    "version": "1.4.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.damho0514.voxelvalley"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4B9C8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.damho0514.voxelvalley",
      "versionCode": 14
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "친구 캐릭터와 말로 대화할 때 마이크를 사용해요."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "내 방 사진이나 스크린샷을 골라 게임 속 집으로 꾸며요.",
          "cameraPermission": "내 공간을 찍어 게임 속 집으로 꾸며요.",
          "microphonePermission": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "친구들과 말로 대화할 때 마이크를 사용해요.",
          "speechRecognitionPermission": "말씀하신 내용을 알아듣고 친구 캐릭터가 대답하는 데 음성 인식을 사용해요.",
          "androidSpeechRecognitionPackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "./plugins/withReleaseSigning",
        {
          "name": "voxel-valley"
        }
      ]
    ],
    "scheme": "voxelvalley",
    "owner": "damho0514",
    "extra": {
      "eas": {
        "projectId": "d94cf81c-bee3-49d1-90c0-20a606d1bb8b"
      }
    }
  }
}
