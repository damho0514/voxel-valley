# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# wrangler local state
.wrangler/

# AirPods bridge build output
/tools/airpods-bridge/build/

# Native module build output
/modules/*/android/build/

# Python bytecode
__pycache__/

# Local editor/assistant settings (kept out of the repo)
/CLAUDE.md
/AGENTS.md
/.claude/
